{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "plugins/**",
      "excludeFiles": ".data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]?path=:path*" },
    { "source": "/media/:path*", "destination": "/api/[...path]?path=media/:path*" },
    { "source": "/plugin-assets/:path*", "destination": "/api/[...path]?path=plugin-assets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; media-src 'self' blob:; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
